generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  
  water_calculations WaterCalculations[] @relation("user_calculations")
  saving_goals       SavingGoals[]       @relation("user_goals")

  @@map("users")
}

model WaterCalculations {
  id                             Int  @id @default(autoincrement())
  user_id                        Int
  household_members              Int?
  shower_minutes                 Int?
  laundry_per_week               Int?
  dishwasher_per_week            Int?
  meat_servings_per_week         Int?
  coffee_cups_per_week           Int?
  clothes_purchased_per_month    Int?
  digital_services_hours_per_day Int?

  /// Estimated total water consumption in liters per day
  estimated_daily_consumption Decimal? @db.Decimal(10, 2)
  created_at                  DateTime @default(now())

  user Users @relation("user_calculations", fields: [user_id], references: [id])

  @@map("water_calculations")
}

model WaterReference {
  id                     Int      @id @default(autoincrement())
  household_members      Int?
  /// Average daily benchmark consumption
  average_liters_per_day Decimal? @db.Decimal(10, 2)

  @@map("water_reference")
}

model SavingGoals {
  id                    Int      @id @default(autoincrement())
  user_id               Int
  /// User target maximum daily consumption
  target_liters_per_day Decimal? @db.Decimal(10, 2)
  /// Optional yearly water saving goal
  yearly_target_liters  Decimal? @db.Decimal(12, 2)
  created_at            DateTime @default(now())

  user Users @relation("user_goals", fields: [user_id], references: [id])

  @@map("saving_goals")
}
